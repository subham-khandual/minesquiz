# ========================================================
# MinesQuiz Backend Server Production Environment Configuration
# ========================================================

# Server Port & Node Environment
PORT=5050
NODE_ENV=production

# MongoDB Atlas Database Connection URI
# Replace <username>, <password>, and <cluster> with your Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mines.mongodb.net/mines-quiz?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated list of domains allowed to access the API)
ALLOWED_ORIGINS=https://minesquiz.com,https://www.minesquiz.com

# Rate Limiting & Admin Master Email (Bypasses local rate-limiting)
ADMIN_EMAIL=subhamkhandual215@gmail.com

# Optional: Firebase Service Account (For Firebase Auth integration if needed)
# FIREBASE_PROJECT_ID=mines-quiz-prod
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mines-quiz-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
